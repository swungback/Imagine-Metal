// ---- IterationT's End (shaders/Lib/IndividualFounctions/EndSky.glsl), ported line for line: the black hole and its accretion
// disc (BlackHole_AccretionDisc_Stars), the stars, and the ringed planet (PlanetEnd2) that circles the horizon over 15 minutes,
// eclipsing the light as it passes. Its noise texture (texture/noise.png, 64x64, linear, repeating) is IT_NOISE.
static float4 itNoise(float2 uv) {
	float2 t = uv * 64.0 - 0.5;
	float2 i = floor(t), fr = t - i;
	int2 a = int2(i) & 63, b = (int2(i) + 1) & 63;
	float4 c00 = float4(IT_NOISE[a.y * 64 + a.x]), c10 = float4(IT_NOISE[a.y * 64 + b.x]);
	float4 c01 = float4(IT_NOISE[b.y * 64 + a.x]), c11 = float4(IT_NOISE[b.y * 64 + b.x]);
	return mix(mix(c00, c10, fr.x), mix(c01, c11, fr.x), fr.y) * (1.0 / 255.0);
}

static inline float itCurve(float x) { return x * x * (3.0 - 2.0 * x); }
static inline float3 itCurve3(float3 x) { return x * x * (3.0 - 2.0 * x); }

static float3 itBlackbody(float temperature) {
	const float4 sx0 = float4(-0.2661293e9, -0.2343589e6, 0.8776956e3, 0.179910);
	const float4 sx1 = float4(-3.0258469e9, 2.1070479e6, 0.2226347e3, 0.240390);
	const float4 sy0 = float4(-1.1063814, -1.34811020, 2.18555832, -0.20219683);
	const float4 sy1 = float4(-0.9549476, -1.37418593, 2.09137015, -0.16748867);
	const float4 sy2 = float4(3.0817580, -5.87338670, 3.75112997, -0.37001483);
	float rt = 1.0 / temperature;
	float rt2 = rt * rt;
	float4 coeffX = float4(rt2 * rt, rt2, rt, 1.0);
	float x = dot(coeffX, temperature < 4000.0 ? sx0 : sx1);
	float x2 = x * x;
	float4 coeffY = float4(x2 * x, x2, x, 1.0);
	float z = 1.0 / dot(coeffY, temperature < 2222.0 ? sy0 : temperature < 4000.0 ? sy1 : sy2);
	float3 xyz = float3(x * z, 1.0, z);
	xyz.z -= xyz.x + 1.0;
	const float3x3 xyzToSrgb = float3x3(float3(3.24097, -0.96924, 0.05563), float3(-1.53738, 1.87597, -0.20398), float3(-0.49861, 0.04156, 1.05697));
	return max(xyzToSrgb * xyz, float3(0.0));
}

static float itMie(float g, float nu) {
	float gg = g * g;
	float k = 0.1193662 * (1.0 - gg) / (2.0 + gg);
	return k * (1.0 + nu * nu) * pow(1.0 + gg - 2.0 * g * nu, -1.5);
}

static float2 itRaySphere(float3 ori, float3 dir, float radius) {
	float b = dot(ori, dir);
	float c = -radius * radius + dot(ori, ori);
	float d = b * b - c;
	float2 r = float2(1e10, -1e10);
	if (d >= 0.0) {
		d = sqrt(d);
		r = float2(-b - d, -b + d);
	}
	return r;
}

static float3 itRayPlane(float3 ori, float3 dir, float3 normal) {
	float a = dot(dir, normal);
	float t = 1e8;
	float3 p = dir * t;
	if (a > 0.0001 || a < -0.0001) {
		t = dot(-ori, normal) / a;
		p = ori + dir * t;
	}
	return p;
}

// the planet's place in its 15-minute circle round the horizon (timeFactor), and how much of the light it lets through
static float itTimeFactor(constant ImFrame &f) {
	return fract(f.world.w * ((1.0 / 60.0) / 15.0) + 0.282) * 6.28318531;
}

static float itPlanetShadow(float tf) {
	return (1.0 - smoothstep(0.35, 0.62, tf)) + smoothstep(1.6, 1.87, tf);
}

static float3 itStars(float3 worldDir, float3 L, float time) {
	float angleY = time * 0.001;
	float3x3 rY = float3x3(float3(cos(angleY), 0.0, sin(angleY)), float3(0.0, 1.0, 0.0), float3(-sin(angleY), 0.0, cos(angleY)));
	worldDir = rY * worldDir;
	const float scale = 384.0, coverage = 0.007, maxLuminance = 0.04;
	float cosine = dot(L, float3(0, 0, 1));
	float3 axis = cross(L, float3(0, 0, 1));
	float cosecantSquared = 1.0 / max(dot(axis, axis), 1e-6);
	worldDir = cosine * worldDir + cross(axis, worldDir) + (cosecantSquared - cosecantSquared * cosine) * dot(axis, worldDir) * axis;
	float3 p = worldDir * scale;
	float3 i = floor(p);
	float3 fq = p - i;
	float r = dot(fq - 0.5, fq - 0.5);
	float3 i3 = fract(i * float3(443.897, 441.423, 437.195));
	i3 += dot(i3, i3.yzx + 19.19);
	float2 hash = fract((i3.xx + i3.yz) * i3.zy);
	hash.y = 2.0 * hash.y - 4.0 * hash.y * hash.y + 3.0 * hash.y * hash.y * hash.y;
	float c = saturate((hash.x - (1.0 - coverage)) / coverage);
	return (maxLuminance * saturate((r - 0.25) / -0.25) * c * c) * itBlackbody(mix(4000.0, 8000.0, hash.y));
}

static float3 itH(float3 albedo, float a) {
	float3 R = sqrt(float3(1.0) - albedo);
	float3 r = (1.0 - R) / (1.0 + R);
	float3 H = r + (0.5 - r * a) * log((1.0 + a) / a);
	H *= albedo * a;
	return 1.0 / (1.0 - H);
}

static float3 itPpss(float3 albedo, float3 normal, float3 eyeDir, float3 lightDir) {
	float NdotL = dot(normal, lightDir);
	float NdotV = dot(normal, eyeDir);
	albedo *= itCurve(saturate(NdotL));
	float3 color = albedo * itH(albedo, max(NdotL, 1e-4)) * itH(albedo, max(NdotV, 1e-4)) / (4.0 * 3.14159265 * max(NdotL + NdotV, 1e-4));
	return saturate(color);
}

static float itDisc(float a, float s, float h) {
	float disc = itCurve(saturate((a - (1.0 - s)) * h));
	return disc * disc;
}

static float itRingNoise(float rayRadius) {
	const float octAlpha = 0.5, octScale = 4.0;
	const float octShift = (octAlpha / octScale) / 5.0;
	float accum = 0.0, alpha = 0.5;
	float position = rayRadius * 0.5 + 0.69;
	for (int i = 0; i < 5; i++) {
		accum += alpha * itNoise(float2(position, 0.0)).z;
		position = position * octScale;
		alpha *= octAlpha;
	}
	return accum + octShift;
}

// PlanetEnd2: in its own units (the planet's radius 1; IterationT's are metres, a 20,000 km planet seen from 15,000 km up)
static void itPlanet(thread float3 &color, float3 rayDir, float3 lightDir, float tf, float planetShadow) {
	const float Rground = 1.0, Ratmo = 1.005;
	float3 eye = float3(0.0, 1.75, 0.0);
	float VdotL = dot(lightDir, rayDir);
	float mie = itMie(0.8, VdotL);
	float angleX = -1.57079633 + (0.2 * sin(tf + 3.0) - 0.1);
	float angleY = tf;
	float3x3 mX = float3x3(float3(1, 0, 0), float3(0, cos(angleX), -sin(angleX)), float3(0, sin(angleX), cos(angleX)));
	float3x3 mY = float3x3(float3(cos(angleY), 0, sin(angleY)), float3(0, 1, 0), float3(-sin(angleY), 0, cos(angleY)));
	float3x3 eyeRot = mX * mY;
	float ringAngle = 0.008 * sin(tf + 4.6);
	float3x3 ringRot = float3x3(float3(1.0, 0.0, 0.0), float3(0.0, cos(ringAngle), sin(ringAngle)), float3(0.0, -sin(ringAngle), cos(ringAngle)));
	float3x3 ringRotInv = transpose(ringRot);
	rayDir = eyeRot * rayDir;
	lightDir = eyeRot * lightDir;
	float3 rayDirRing = ringRot * rayDir;
	float3 lightDirRing = ringRot * lightDir;
	float3 ringOrigin = float3(0.0, cos(ringAngle), sin(ringAngle)) * (eye.y / Rground);
	float2 ringRadius = float2(1.6, 2.6);

	float3 surface = float3(0.0);
	float2 gi = itRaySphere(eye, rayDir, Rground);
	float2 ti = itRaySphere(eye, rayDir, Ratmo);
	float3 surfacePos = rayDir * gi.x;
	float3 surfaceNormal = normalize(surfacePos + float3(0.0, eye.y, 0.0));
	if (gi.y > 0.0) {
		color *= 0.0;
		float3 albedo = float3(0.98, 0.87, 0.55);
		surface = itPpss(albedo, surfaceNormal, -rayDir, lightDir);
		float3 origin = ringOrigin + surfacePos / Rground;
		float3 rp = itRayPlane(origin, lightDirRing, float3(0.0, 0.0, 1.0));
		float rr = length(rp);
		if (rr > ringRadius.x && rr < ringRadius.y && dot(rp - origin, lightDirRing) > 0.0)
			surface *= exp(-pow(saturate(itRingNoise(rr) - 0.1) * 1.5, 3.0) * smoothstep(ringRadius.x, ringRadius.x * 1.1, rr));
		float UdotN = saturate(dot(ringRotInv[2], surfaceNormal));
		float DdotN = saturate(dot(-ringRotInv[2], surfaceNormal));
		float OLdotN = saturate(dot(ringRotInv * normalize(float3(-lightDir.xy, 0.0) + float3(1e-6, 0.0, 0.0)), surfaceNormal));
		float ringLighting = itDisc(UdotN, 1.2, 1.5) * (1.0 - itDisc(UdotN, 3.4, 0.3));
		ringLighting += itDisc(DdotN, 1.2, 1.5) * (1.0 - itDisc(DdotN, 3.4, 0.3));
		ringLighting *= 1.0 - itDisc(OLdotN, 0.7, 1.3);
		surface += albedo * (1.5e-4 + ringLighting * 0.01);
	}
	if (ti.y > 0.0) {
		float isGround = step(0.0, gi.y);
		// (IterationT's thickness in its units x 1e-7: here in planet radii, x 2)
		float thickness = (ti.y - ti.x - (gi.y - gi.x) * isGround) * 2.0;
		float topMie = mie * thickness * thickness;
		topMie *= mix(1.0, 1.0 - smoothstep(0.4, 0.9, dot(surfaceNormal, normalize(eye))), isGround);
		surface += topMie * float3(0.65, 0.7, 1.0);
	}
	color += surface * 0.6;

	float inRing = saturate(abs(ringAngle) * 3000.0 - 0.8);
	float ring = 0.0, transmittance = 1.0;
	if (rayDirRing.z * ringAngle < 0.0) {
		float3 origin = float3(0.0, cos(ringAngle), sin(ringAngle)) * (eye.y / Rground);
		float3 ringPos = itRayPlane(origin, rayDirRing, float3(0.0, 0.0, 1.0));
		float rr = length(ringPos);
		if (rr > ringRadius.x && rr < ringRadius.y) {
			ring += pow(saturate(itRingNoise(rr) - 0.1) * 1.5, 3.0);
			ring *= smoothstep(ringRadius.x, ringRadius.x * 1.1, rr);
			if (ringPos.y < 0.0 && gi.y > 0.0) ring *= 0.0;
			else transmittance *= exp2(-ring * 3.0);
			float d = length(cross(lightDirRing, ringPos));
			ring *= 0.98 * max(smoothstep(0.8, 1.2, d), step(0.0, dot(lightDirRing, ringPos))) + 0.02;
		}
	}
	ring = mix(planetShadow * 0.49 + 0.01, ring, inRing);
	transmittance = mix(0.7, transmittance, inRing);
	color *= transmittance;
	ring *= 1.0 + mie * 10.0 * planetShadow;
	color += ring * 0.012 * float3(1.0, 0.85, 0.60);
}

static float3x3 itRotate(float x, float y, float z) {
	float3x3 mx = float3x3(float3(1.0, 0.0, 0.0), float3(0.0, cos(x), sin(x)), float3(0.0, -sin(x), cos(x)));
	float3x3 my = float3x3(float3(cos(y), 0.0, -sin(y)), float3(0.0, 1.0, 0.0), float3(sin(y), 0.0, cos(y)));
	float3x3 mz = float3x3(float3(cos(z), sin(z), 0.0), float3(-sin(z), cos(z), 0.0), float3(0.0, 0.0, 1.0));
	return my * mx * mz;
}

static float it3DNoise(float3 position) {
	float3 p = floor(position);
	float3 b = itCurve3(fract(position));
	float2 uv = 17.0 * p.z + p.xy + b.xy;
	float2 rg = itNoise((uv + 0.5) / 64.0).zx;
	return mix(rg.x, rg.y, b.z);
}

static float itCloudFBM(float3 position, float3 shift) {
	const float octAlpha = 0.87, octScale = 2.5;
	const float octShift = (octAlpha / octScale) / 4.0;
	float accum = 0.0, alpha = 0.5;
	for (int i = 0; i < 4; i++) {
		accum += alpha * it3DNoise(position);
		position = (position + shift) * octScale;
		alpha *= octAlpha;
	}
	return accum + octShift;
}

static float3 imBlackHoleSky(float3 d, float2 pixel, constant ImFrame &f, thread float3 &hdr) {
	float3 L = normalize(f.lightDir.xyz);
	float time = f.world.w;
	hdr = float3(0.0);
	float3 color = float3(0.0);
	float3 rayDir = d;
	float3 result = float3(0.0);
	float transmittance = 1.0;
	// BlackHole_AccretionDisc_Stars (its 50 steps only toward the black hole, where its light bends and its disc is: elsewhere
	// the ray goes straight and the sum is nothing)
	float near = dot(d, L);
	if (near > 0.8) {
		const int steps = 50;
		const float stepLength = 0.2;
		const float discInner = 2.25 - 3.5 * 0.5, discWidth = 3.5;
		float noise = fract(52.9829189 * fract(dot(pixel, float2(0.06711056, 0.00583715))) + 0.61803399 * float(f.flags.w & 63));
		float3 eye = -L * 8.0;
		float3 rayPos = eye + rayDir * 3.0;
		float3x3 rotation = itRotate(0.1, 0.0, -0.35);
		rayPos += rayDir * stepLength * noise;
		for (int i = 0; i < steps; i++) {
			if (transmittance < 0.0001) break;
			float sd = length(rayPos);
			float warp = 1.0 / (sd * sd + 0.000001);
			rayDir = normalize(rayDir + normalize(-rayPos) * warp * 0.06);
			rayPos += rayDir * stepLength;
			float3 discPos = rotation * rayPos;
			float r = length(discPos);
			float p = atan2(-discPos.x, -discPos.z);
			float h = discPos.y;
			float radialGradient = 1.0 - saturate((r - discInner) / discWidth * 0.5);
			float dist = abs(h);
			float discThickness = 0.1 * radialGradient;
			float fr = abs(r - discInner) + 0.4;
			fr = fr * fr;
			float fade = fr * fr * 0.04;
			float bloomFactor = 1.0 / (h * h * 40.0 + fade + 0.00002);
			bloomFactor *= saturate(2.0 - dist / max(discThickness, 1e-5));
			bloomFactor = bloomFactor * bloomFactor;
			float x2 = radialGradient * radialGradient;
			float dr = 12.207 * x2 * x2 * (1.0 - radialGradient);
			float density = dr;
			density *= saturate(1.0 - dist / max(discThickness, 1e-5));
			density = saturate(density * 0.7);
			density = saturate(density + bloomFactor * 0.1);
			if (density > 0.0001) {
				float3 discCoord = float3(r, 0.0, h * 0.1) * 3.5;
				float fbm = itCloudFBM(discCoord, time * float3(0.03, 0.05, 0.0));
				fbm = fbm * fbm;
				fbm = fbm * fbm;
				density *= fbm * dr;
				float gr = 1.0 - radialGradient;
				gr = gr * gr;
				float glowStrength = 1.0 / (gr * gr * 400.0 + 0.002);
				float3 glow = itBlackbody(2700.0 + glowStrength * 50.0) * glowStrength;
				glow *= sin(p - 1.07) * 0.75 + 1.0;  // (ACCRETIONDISC_DOPPLER_EFFECT, on in IterationT)
				float stepT = exp2(-density * 7.0);
				transmittance *= stepT;
				result += (1.0 - stepT) * transmittance * glow;
			}
			float torusDist = length(float2(length(discPos + float3(0.0, -0.05, 0.0)) - 1.0, length(discPos + float3(0.0, -0.05, 0.0)) - 0.01));
			float bloomDisc = 1.0 / (pow(torusDist, 3.5) + 0.001);
			bloomDisc *= step(0.5, r);
			result += itBlackbody(12000.0) * bloomDisc * 0.1 * transmittance;
		}
		result *= 1.0 / float(steps);
		float edge = smoothstep(0.8, 0.86, near);
		result *= edge;
		transmittance = mix(1.0, transmittance, edge);
		rayDir = normalize(mix(d, rayDir, edge));
	}
	color += itStars(rayDir, L, time);
	color *= transmittance;
	color += result;
	float tf = itTimeFactor(f);
	itPlanet(color, d, L, tf, itPlanetShadow(tf));
	hdr += min(result * 0.35, float3(3.0));
	return color;
}

static float4 imSkyPixel(ImSkyOut in, constant ImFrame &f, constant float4x4 &rot);

fragment float4 im_sky_fs(ImSkyOut in [[stage_in]], constant ImFrame &f [[buffer(0)]], constant float4x4 &rot [[buffer(1)]]) {
	return imSkyPixel(in, f, rot);
}

// The End's sky, drawn once the level has (Sky.drawEndLate): only where nothing was drawn (the depth still at its clear), so no
// pass of Minecraft's can clear over it, and the bloom that follows picks up the black hole's glow.
fragment float4 im_sky_end_fs(ImSkyOut in [[stage_in]], constant ImFrame &f [[buffer(0)]], constant float4x4 &rot [[buffer(1)]],
	depth2d<float> depth [[texture(2)]]) {
	uint2 px = min(uint2(in.pos.xy), uint2(depth.get_width() - 1, depth.get_height() - 1));
	if (depth.read(px) > 0.00001) discard_fragment();  // (the game's depth is reversed: 0 is the far plane, the sky)
	return imSkyPixel(in, f, rot);
}

static float4 imSkyPixel(ImSkyOut in, constant ImFrame &f, constant float4x4 &rot) {
	// (the backend flips vertex y so its images keep GL's row order: this pixel is where clip y = -ndc.y lands)
	float4 q = rot * float4(in.ndc.x, -in.ndc.y, 0.5, 1.0);
	float3 d = normalize(q.xyz / q.w);
	// (through the same exposure, tone curve and grade as the terrain, as Reimagined's sky goes through its tonemap with the rest)
	// the End's flashes: a burst of violet light somewhere in the sky, a bright core in a wide glow, washing the whole sky faintly
	float3 flash = float3(0.0);
	if (f.flags.x == 2 && f.endFlash.w > 0.0) {
		float fd = saturate(dot(d, f.endFlash.xyz));
		flash = float3(0.75, 0.45, 1.0) * f.endFlash.w * (pow(fd, 300.0) * 6.0 + pow(fd, 12.0) * 0.6 + 0.05);
	}
	if (f.flags.x == 2 && f.nether.x > 0.5) {
		// (IterationT's End has no flashes: Minecraft's End flash, a violet burst, washed its black sky lavender)
		float3 hdr;
		float3 bh = imBlackHoleSky(d, in.pos.xy, f, hdr);
		return float4(pow(imPresent(bh, f), 1.0 / 2.2) + hdr, 1.0);
	}
	if (f.flags.x == 2) {
		// the End (Reimagined's): a deep violet sky full of tiny stars, thickest toward the horizon, both above and below
		float3 endSky = float3(0.095, 0.07, 0.15) * 1.65;
		float2 sc = (0.65 * d / (abs(d.y) + length(d.xz))).xz * 0.5;
		if (d.y < 0.0) sc += 100.0;
		float2 cell = floor(sc * 1024.0) / 1024.0;
		float st = imStarNoise(cell) * imStarNoise(cell + 0.1) * imStarNoise(cell + 0.23);
		st = max(st - 0.7, 0.0);
		st *= st;
		float au = abs(d.y), vu2 = (1.0 - au) * (1.0 - au);
		float3 stars = st * endSky * 3000.0 * (min(vu2 + 0.015, 0.05) + 0.015) * smoothstep(0.0, 0.25, au);
		// (deeper overhead, a glowing lavender band along the horizon, and slow nebula clouds drifting through it, pink and teal,
		// so the End's sky has depth instead of one flat violet)
		float3 base = endSky * mix(0.5, 1.45, pow(1.0 - au, 3.0));
		float2 nq = d.xz / (abs(d.y) + 0.35) * 1.6 + f.world.w * 0.004;
		float nb = 0.0, amp = 0.5;
		for (int i = 0; i < 4; i++) {
			nb += amp * imValueNoise(nq);
			nq = nq * 2.1 + 3.7;
			amp *= 0.5;
		}
		float neb = smoothstep(0.42, 0.85, nb) * (1.0 - au * 0.6);
		float tone = imValueNoise(nq * 0.15 + 11.0);
		float3 nebCol = mix(float3(0.42, 0.12, 0.45), float3(0.12, 0.3, 0.42), tone) * neb * 0.32;
		return float4(pow(imPresent(base + nebCol + stars + flash, f), 1.0 / 2.2), 1.0);
	}
	float3 sky = imSkyColor(d, f, true);
	uint st = uint(f.auroraLight.w + 0.5);
	if (st != 0u && d.y > 0.0 && f.flags.x == 0) {
		if ((st & 1u) != 0u) sky += imStars(d, f);
		if (f.extra.w > 0.5) {
			// a night nebula: a faint band of violet and blue cloud across the sky, the galaxy's arm, under the stars
			float inv = f.sunsetDown.w * f.sunsetDown.w;
			float vis = (1.0 - f.dayUp.w) * inv * inv * (1.0 - f.nightMiddle.w);
			if (vis > 0.0) {
				float3 axis = normalize(float3(0.35, 0.25, 0.9));
				float band = exp(-pow(dot(d, axis) * 3.2, 2.0));
				float2 nq = float2(atan2(d.z, d.x), d.y) * float2(2.2, 4.0);
				float nb = 0.0, amp = 0.5;
				for (int i = 0; i < 4; i++) {
					nb += amp * imValueNoise(nq);
					nq = nq * 2.1 + 1.7;
					amp *= 0.5;
				}
				float neb = smoothstep(0.35, 0.8, nb) * band;
				float3 nc = mix(float3(0.25, 0.1, 0.45), float3(0.1, 0.25, 0.55), imValueNoise(nq * 0.2 + 5.0));
				sky += nc * neb * 0.05 * vis * smoothstep(0.0, 0.2, d.y);
			}
		}
		if ((st & 2u) != 0u) {
			float inv = f.sunsetDown.w * f.sunsetDown.w;
			float vis = (1.0 - f.dayUp.w) * inv * inv * (1.0 - f.nightMiddle.w);
			if (vis > 0.0) {
				float t = f.world.w;
				float ss = imShootingStar(d, t, 9.0, 0.0) + imShootingStar(d, t + 4.0, 13.0, 3.0);
				sky += float3(0.9, 0.95, 1.0) * (14.0 * ss * vis);
			}
		}
	}
	float3 col = pow(imPresent(sky, f), 1.0 / 2.2);
	// the sun's glare (Reimagined's sun: white-hot, the bloom throwing a wide halo in its light's colour): a core past white under
	// Minecraft's sun square (drawn over this), so the bloom picks it up; gone in rain and once it has set
	if (f.flags.x == 0 && f.lightDir.w > 0.5) {
		float vs = saturate(dot(d, f.sunDir.xyz));
		float core = smoothstep(0.9965, 0.9992, vs);
		float halo = pow(vs, 600.0) * 0.6;
		float k = (core * 2.5 + halo) * (1.0 - f.dayUp.w) * smoothstep(-0.02, 0.06, f.sunDir.y);
		float3 lc = f.lightColor.rgb / max(max(max(f.lightColor.r, f.lightColor.g), f.lightColor.b), 1e-3);
		col += mix(lc, float3(1.0), core * 0.6) * k;
	}
	return float4(col, 1.0);
}

// ---- clouds (Complementary Reimagined's blocky clouds, lib/atmospherics/clouds/reimaginedClouds.glsl) and the aurora ----
// Minecraft's own cloud map (one texel 12 blocks) at Minecraft's cloud height, each cell traced as a block with rounded edges and
// a rounded top and bottom (SixthSurge's rounded coordinates); lit from the top down, darker where more cloud lies toward the
// light; blended toward the sky behind with distance. Drawn after Minecraft's sun, moon and stars, so clouds pass in front of them.

constant float IM_CLOUD_STRETCH = 4.0;   // half the clouds' thickness (blocks)
constant float IM_CLOUD_ROUND = 0.125;

static inline float imCloudMap(texture2d<float> ct, sampler s, float2 texel) {
	// (wrapped into one positive copy of the map first: the old mirroring of negative coordinates turned the map around the
	// moment the camera crossed the map's edge, every 3072 blocks, and the clouds jumped)
	float2 sz = float2(ct.get_width(), ct.get_height());
	float2 c = texel + 0.5;
	c = c - floor(c / sz) * sz + sz;
	float2 i = floor(c), fr = c - i;
	fr = smoothstep(0.5 - IM_CLOUD_ROUND, 0.5 + IM_CLOUD_ROUND, fr);
	c = i + fr - 0.5;
	return ct.sample(s, c / sz).r;
}

static float4 imClouds(float3 d, constant ImFrame &f, texture2d<float> ct, sampler s, float dither) {
	float camY = f.fogParams.y, alt = f.cloudPos.z;
	float hi = alt + IM_CLOUD_STRETCH, lo = alt - IM_CLOUD_STRETCH;
	if (abs(d.y) < 1e-4) return float4(0.0);
	float tLo = (lo - camY) / d.y, tHi = (hi - camY) / d.y;
	float tMin = max(min(tLo, tHi), 0.0), tMax = max(tLo, tHi);
	if (tMax <= 0.0) return float4(0.0);
	const float reach = 4000.0;
	tMax = min(tMax, reach / max(length(d.xz), 1e-3));
	if (tMax <= tMin) return float4(0.0);
	int count = clamp(int((tMax - tMin) / 8.0), 12, 40);
	float stepLen = (tMax - tMin) / float(count);
	float t = tMin + stepLen * dither;
	float rain = f.dayUp.w, sunVis = f.nightMiddle.w, noon = f.dayDown.w, shadowTime = f.nightDown.w, sunFactor = f.dayMiddle.w;
	for (int i = 0; i < count; i++, t += stepLen) {
		float3 p = d * t;  // camera-relative
		float y = camY + p.y;
		float2 texel = f.cloudPos.xy + p.xz / 12.0;
		float th = saturate(abs(alt - y) / IM_CLOUD_STRETCH);
		th = th * th;
		th = th * th;
		th = th * th;
		if (imCloudMap(ct, s, texel) <= th * 0.5 + 0.25) continue;
		// lit from the top down, and less where more cloud lies toward the light (two looks along it)
		float shade = pow(max(1.0 - (hi - y) / (IM_CLOUD_STRETCH * 2.0), 0.0), 0.8);
		float shadeM = 1.0 - shade * shade;
		float2 toLight = f.lightDir.xz * (0.08 * shadowTime);  // (Reimagined's: in cloud-map texels)
		float light = 2.0;
		light -= imCloudMap(ct, s, texel + toLight * (1.0 + dither)) * shadeM;
		light -= imCloudMap(ct, s, texel + toLight * (1.0 + 2.0 * dither)) * shadeM;
		float VdotS = dot(d, f.sunDir.xyz);
		float vs = max(sunVis > 0.5 ? VdotS : -VdotS, 0.0);
		shade = (vs * shadowTime * 0.25 + 0.5 * shade + 0.08) * light;
		float3 rainCol = mix(f.nightMiddle.rgb, f.dayMiddle.rgb, sunFactor);
		float3 amb = mix(f.ambientUp.rgb * (sunVis * sunVis * (0.55 + float3(0.2, 0.1, 0.0) * noon) + 0.35), rainCol * 0.5, rain) * (1.0 - 0.25 * rain);
		float3 lit = mix(f.lightColor.rgb * 1.3, rainCol * 0.45, noon * rain);
		float3 col = amb * 0.95 * (1.0 - 0.35 * shade) + lit * 0.9 * (0.1 + shade);
		float dxz = length(p.xz);
		float ratio = saturate((reach - dxz) / reach);
		float fogF = ratio * ratio * 0.707;
		col = mix(imSkyColor(d, f, false), col, fogF * 0.707);
		float a = sqrt(min(ratio, 0.75) * 1.33333);
		return float4(col, a);
	}
	return float4(0.0);
}

// Reimagined's aurora (lib/atmospherics/auroraBorealis.glsl, its second style): curtains of noise on a plane above, pink-violet
// below, green at their height. At night in cold biomes (f.aurora.x its visibility).
static float3 imAurora(float3 d, constant ImFrame &f, texture2d<float> nt, sampler s, float dither) {
	float u = saturate(d.y * 1.5 - 0.225);
	float vis = u * (2.0 - u) * f.aurora.x * (1.0 - d.y * 0.9);
	if (vis <= 0.0) return float3(0.0);
	float2 w = d.xz / max(d.y, 0.05);
	float3 acc = float3(0.0);
	const int N = 16;
	for (int i = 0; i < N; i++) {
		float cur = (float(i) + dither + 5.0) / float(N + 5);
		cur *= cur;
		float2 pp = w * (0.8 + cur) * 11.0 + f.aurora.zw;
		if (f.auroraLow.w > 0.5) pp = floor(pp);  // (Reimagined's pixel style: curtains in blocky steps)
		pp *= 0.0007;
		float n = nt.sample(s, pp).r;
		n = 1.0 - 2.0 * abs(n - 0.5);
		n *= n;
		n *= n;
		n *= n;
		n *= n;
		n *= nt.sample(s, pp * 3.0 + f.aurora.y).b;
		n *= nt.sample(s, pp * 5.0 - f.aurora.y).b;
		float cm = 1.0 - cur;
		float cm2 = cm * cm;
		acc += n * cm * mix(f.auroraLow.rgb, f.auroraHigh.rgb, cm2 * cm2);
	}
	return acc * ((f.auroraLow.w > 0.5 ? 1.3 : 1.8) * f.auroraHigh.w * vis / float(N));
}

fragment float4 im_clouds_fs(ImSkyOut in [[stage_in]], constant ImFrame &f [[buffer(0)]], constant float4x4 &rot [[buffer(1)]],
	texture2d<float> clouds [[texture(0)]], texture2d<float> noise [[texture(1)]], sampler rs [[sampler(0)]]) {
	float4 q = rot * float4(in.ndc.x, -in.ndc.y, 0.5, 1.0);
	float3 d = normalize(q.xyz / q.w);
	float dither = fract(52.9829189 * fract(dot(in.pos.xy, float2(0.06711056, 0.00583715))));
	float3 aurora = f.aurora.x > 0.0 ? imAurora(d, f, noise, rs, dither) : float3(0.0);
	float4 c = f.cloudPos.w > 0.5 ? imClouds(d, f, clouds, rs, dither) : float4(0.0);
	c.rgb += aurora * 0.1;
	// premultiplied: the clouds over what's there, the aurora added behind them
	float3 col = pow(imPresent(c.rgb, f), 1.0 / 2.2) * c.a + pow(imPresent(aurora, f), 1.0 / 2.2) * (1.0 - c.a);
	if (c.a <= 0.0 && max(max(aurora.r, aurora.g), aurora.b) <= 0.0) discard_fragment();
	return float4(col, c.a);
}
